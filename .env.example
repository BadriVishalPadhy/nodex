# ===========================================
# N8N Platform - Environment Variables
# ===========================================
# Copy this file to .env and fill in real values
# NEVER commit the .env file to version control
# ===========================================

# ---------- Database ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<strong-password-here>
POSTGRES_DB=n8n
DATABASE_URL=postgresql://postgres:<strong-password-here>@postgres:5432/n8n

# ---------- Auth ----------
JWT_SECRET=<generate-a-random-64-char-string>

# ---------- Kafka ----------
KAFKA_BROKER=<your-kafka-broker-url>


# ---------- Email (SendGrid) ----------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=


# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://server:8000
# Optional: public base URL for the webhooks service shown in the dashboard.
# Defaults to <page-protocol>//<hostname>:4000. Set this (e.g. https://nodex.codes)
# when the webhooks service is exposed behind a reverse proxy. Inlined at build
# time, so it must also be passed as a Docker build arg if used.
# NEXT_PUBLIC_WEBHOOK_URL=
