# ===========================================
# N8N Platform - Environment Variables
# ===========================================
# Copy this file to .env and fill in real values
# NEVER commit the .env file to version control
# ===========================================

# ---------- Database ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<strong-password-here>
POSTGRES_DB=n8n
DATABASE_URL=postgresql://postgres:<strong-password-here>@postgres:5432/n8n

# ---------- Auth ----------
JWT_SECRET=<generate-a-random-64-char-string>

# ---------- Kafka ----------
KAFKA_BROKER=<your-kafka-broker-url>

# ---------- Helius ----------
HELIUS_API_KEY=
HOOKS_BASE_URL=

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://server:8000
