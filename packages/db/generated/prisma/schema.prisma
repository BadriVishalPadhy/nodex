// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  password          String
  name              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  workflows         WorkFlow[]
  scheduledMessages ScheduledMessage[]
}

model WorkFlow {
  id           String        @id @default(uuid())
  name         String        @default("Untitled Workflow")
  triggerId    String
  user         User          @relation(fields: [userId], references: [id])
  userId       String
  triggerNodes TriggerNodes?
  actionsNodes ActionNodes[]
  workflowRun  WorkFlowRun[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  deletedAt    DateTime?

  @@index([userId])
}

model TriggerNodes {
  id            String                @id @default(uuid())
  workflow      WorkFlow              @relation(fields: [workflowId], references: [id])
  workflowId    String                @unique
  metadata      Json                  @default("{}")
  TriggerNodeId String
  type          AvailableTriggerNodes @relation(fields: [TriggerNodeId], references: [id])
}

model AvailableTriggerNodes {
  id          String         @id @default(uuid())
  name        String
  TriggerNode TriggerNodes[]
}

model ActionNodes {
  id           String               @id @default(uuid())
  workflow     WorkFlow             @relation(fields: [workflowId], references: [id])
  workflowId   String
  ActionNodeId String
  metadata     Json                 @default("{}")
  sortingOrder Int                  @default(0)
  type         AvailableActionNodes @relation(fields: [ActionNodeId], references: [id])

  @@index([workflowId])
}

model AvailableActionNodes {
  id          String        @id @default(uuid())
  name        String
  actionNodes ActionNodes[]
}

model WorkFlowRun {
  id         String          @id @default(uuid())
  workflow   WorkFlow        @relation(fields: [workflowId], references: [id])
  workflowId String
  meta       Json
  outbox     WorkFlowOutBox?

  @@index([workflowId])
}

model WorkFlowOutBox {
  id            String      @id @default(uuid())
  WorkFlowRunId String      @unique
  workFlowRun   WorkFlowRun @relation(fields: [WorkFlowRunId], references: [id])
}

model ScheduledMessage {
  id          String    @id @default(uuid())
  channel     String // "email" | "telegram" | "discord"
  recipient   String // email address, chat ID, or webhook URL
  message     String // message body
  subject     String? // email subject (optional)
  username    String? // discord bot name (optional)
  scheduledAt DateTime // when to send
  status      String    @default("pending") // "pending" | "sent" | "failed"
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  error       String?
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  @@index([status, scheduledAt])
  @@index([userId])
}

// Idempotency marker: records that a workflow run's stage has had its side
// effect executed, so a redelivered/retried Kafka message does not run it
// again (Kafka is at-least-once and the worker re-queues on transient errors).
model ProcessedStage {
  workFlowRunId String
  stage         Int
  processedAt   DateTime @default(now())

  @@id([workFlowRunId, stage])
}
